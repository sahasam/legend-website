{
  // Cloudflare Workers static-assets config. No Worker script is needed for a
  // pure static site — pointing at the built assets directory is the entry point.
  "name": "legend-website",
  "compatibility_date": "2026-06-08",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths so client-side routes
    // (e.g. /writing/:slug) resolve on direct visits and hard refreshes.
    "not_found_handling": "single-page-application"
  }
  // Custom domains (sahas.lol, www.sahas.lol) are attached in the Cloudflare
  // dashboard (Workers → legend-website → Domains & Routes), NOT here. Declaring
  // them as `routes` makes the CI `wrangler deploy` try to register them and the
  // domains/records API call fails the whole deploy. Add domains in the dashboard.
}
